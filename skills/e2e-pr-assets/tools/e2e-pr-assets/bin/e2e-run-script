#!/usr/bin/env bash
# e2e-run-script <scenario.mjs> [--record] [--label before|after] [--repo /path/to/repo] [--base-url URL] [--headed]
# Runs an agent-generated Playwright scenario that is not part of the committed e2e suite.

set -euo pipefail

SCENARIO="${1:-}"
RECORD=false
LABEL="run"
REPO_ROOT=""
BASE_URL="http://localhost:3000"
HEADED=false

if [[ -n "$SCENARIO" ]]; then
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --record)
      RECORD=true
      shift
      ;;
    --label)
      LABEL="${2:-}"
      shift 2
      ;;
    --repo)
      REPO_ROOT="${2:-}"
      shift 2
      ;;
    --base-url)
      BASE_URL="${2:-}"
      shift 2
      ;;
    --headed)
      HEADED=true
      shift
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: e2e-run-script <scenario.mjs> [--record] [--label before|after] [--repo /path/to/repo] [--base-url URL] [--headed]" >&2
      exit 1
      ;;
  esac
done

if [[ -z "$SCENARIO" ]]; then
  echo "Usage: e2e-run-script <scenario.mjs> [--record] [--label before|after] [--repo /path/to/repo] [--base-url URL] [--headed]" >&2
  exit 1
fi

if [[ ! -f "$SCENARIO" ]]; then
  echo "Error: scenario file not found: $SCENARIO" >&2
  exit 1
fi

if [[ -z "$REPO_ROOT" ]]; then
  REPO_ROOT="$(pwd)"
fi

if [[ ! -d "$REPO_ROOT" ]]; then
  echo "Error: repo directory not found: $REPO_ROOT" >&2
  exit 1
fi

cd "$REPO_ROOT"

export SCENARIO
export RECORD
export LABEL
export REPO_ROOT
export BASE_URL
export HEADED

node <<'NODE'
const fs = require('node:fs')
const childProcess = require('node:child_process')
const os = require('node:os')
const path = require('node:path')
const { pathToFileURL } = require('node:url')
const { chromium, expect } = require('@playwright/test')

const scenarioPath = path.resolve(process.env.SCENARIO)
const repoRoot = path.resolve(process.env.REPO_ROOT)
const label = process.env.LABEL
const baseURL = process.env.BASE_URL
const record = process.env.RECORD === 'true'
const headed = process.env.HEADED === 'true'
const videoDir = path.join('/tmp', `payload-e2e-script-${Date.now()}`)
const userDataDir = fs.mkdtempSync(path.join(os.tmpdir(), 'payload-e2e-script-profile-'))

const keyLabels = {
  Alt: 'Alt',
  ArrowDown: '↓',
  ArrowLeft: '←',
  ArrowRight: '→',
  ArrowUp: '↑',
  Control: 'Ctrl',
  Enter: 'Enter',
  Escape: 'Esc',
  Meta: '⌘',
  Shift: 'Shift',
  Tab: 'Tab',
}

function normalizeKeyName(key) {
  if (key === 'ControlOrMeta') {
    return process.platform === 'darwin' ? '⌘' : 'Ctrl'
  }

  return keyLabels[key] || (key.length === 1 ? key.toUpperCase() : key)
}

function normalizeCommand(command) {
  let keys

  if (Array.isArray(command)) {
    keys = command
  } else if (command === '+') {
    keys = ['+']
  } else {
    keys = command.split('+')

    if (command.endsWith('+')) {
      keys.pop()
      keys.push('+')
    }
  }

  return [...new Set(keys.filter(Boolean).map(normalizeKeyName))]
}

async function installInteractionOverlays(page) {
  const interactionScript = () => {
    const appendToDocument = (element) => {
      if (document.documentElement) {
        document.documentElement.appendChild(element)
        return
      }

      document.addEventListener('DOMContentLoaded', () => {
        document.documentElement?.appendChild(element)
      }, { once: true })
    }

    window.__payloadE2ECursor = {
      ensure() {
        let cursor = document.getElementById('payload-e2e-cursor')

        if (!cursor) {
          cursor = document.createElement('div')
          cursor.id = 'payload-e2e-cursor'
          cursor.style.position = 'fixed'
          cursor.style.left = '0'
          cursor.style.top = '0'
          cursor.style.width = '22px'
          cursor.style.height = '22px'
          cursor.style.border = '3px solid #111827'
          cursor.style.borderRadius = '9999px'
          cursor.style.background = 'rgba(255, 255, 255, .85)'
          cursor.style.boxShadow = '0 0 0 3px rgba(59, 130, 246, .35), 0 8px 18px rgba(0, 0, 0, .25)'
          cursor.style.pointerEvents = 'none'
          cursor.style.transform = 'translate(-50%, -50%)'
          cursor.style.transition = 'left 130ms ease, top 130ms ease, transform 100ms ease'
          cursor.style.zIndex = '2147483647'
          appendToDocument(cursor)
        }

        return cursor
      },
      moveTo(x, y) {
        const cursor = this.ensure()
        cursor.style.left = `${x}px`
        cursor.style.top = `${y}px`
      },
      pulse() {
        const cursor = this.ensure()
        cursor.style.transform = 'translate(-50%, -50%) scale(.72)'
        window.setTimeout(() => {
          cursor.style.transform = 'translate(-50%, -50%) scale(1)'
        }, 120)
      },
    }
    window.__payloadE2ECursor.moveTo(window.innerWidth / 2, window.innerHeight / 2)

    window.__payloadE2EKeyboard = {
      held: [],
      hideTimer: null,
      ensure() {
        let overlay = document.getElementById('payload-e2e-keyboard')

        if (!overlay) {
          overlay = document.createElement('div')
          overlay.id = 'payload-e2e-keyboard'
          Object.assign(overlay.style, {
            alignItems: 'center',
            background: 'rgba(17, 24, 39, .9)',
            border: '1px solid rgba(255, 255, 255, .2)',
            borderRadius: '12px',
            bottom: '36px',
            boxShadow: '0 10px 28px rgba(0, 0, 0, .3)',
            color: '#fff',
            display: 'flex',
            fontFamily: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
            fontSize: '18px',
            fontWeight: '600',
            gap: '8px',
            left: '50%',
            lineHeight: '1.2',
            opacity: '0',
            padding: '10px 14px',
            pointerEvents: 'none',
            position: 'fixed',
            transform: 'translateX(-50%)',
            transition: 'opacity 160ms ease',
            zIndex: '2147483647',
          })
          appendToDocument(overlay)
        }

        return overlay
      },
      render(tokens, shouldLinger = true) {
        const overlay = this.ensure()
        const visibleTokens = [...new Set([...this.held, ...tokens])]
        const elements = []

        visibleTokens.forEach((token, index) => {
          if (index > 0) {
            const separator = document.createElement('span')
            separator.textContent = '+'
            separator.style.opacity = '.7'
            elements.push(separator)
          }

          const keycap = document.createElement('span')
          keycap.textContent = token
          Object.assign(keycap.style, {
            background: 'rgba(255, 255, 255, .14)',
            border: '1px solid rgba(255, 255, 255, .28)',
            borderRadius: '6px',
            boxShadow: 'inset 0 -1px 0 rgba(255, 255, 255, .1)',
            padding: '3px 8px',
            whiteSpace: 'nowrap',
          })
          elements.push(keycap)
        })

        overlay.replaceChildren(...elements)
        overlay.style.opacity = visibleTokens.length > 0 ? '1' : '0'
        window.clearTimeout(this.hideTimer)

        if (shouldLinger && this.held.length === 0 && visibleTokens.length > 0) {
          this.hideTimer = window.setTimeout(() => {
            overlay.style.opacity = '0'
          }, 800)
        }
      },
      show(tokens) {
        this.render(tokens)
      },
      down(token) {
        if (!this.held.includes(token)) {
          this.held.push(token)
        }
        this.render([], false)
      },
      up(token) {
        this.held = this.held.filter((heldKey) => heldKey !== token)
        this.render(this.held.length > 0 ? [] : [token])
      },
    }
  }

  await page.addInitScript(interactionScript)
  await page.evaluate(interactionScript)
}

async function createCursorHelper(page) {
  const moveToLocator = async (locator) => {
    await locator.scrollIntoViewIfNeeded()
    const box = await locator.boundingBox()

    if (!box) {
      return
    }

    const x = box.x + box.width / 2
    const y = box.y + box.height / 2
    await page.evaluate(({ x: cursorX, y: cursorY }) => {
      window.__payloadE2ECursor?.moveTo(cursorX, cursorY)
    }, { x, y })
    await page.mouse.move(x, y, { steps: 6 })
    await page.waitForTimeout(90)
  }

  return {
    async click(target, options) {
      const locator = typeof target === 'string' ? page.locator(target) : target
      await moveToLocator(locator)
      await page.evaluate(() => window.__payloadE2ECursor?.pulse())
      await locator.click(options)
      await page.waitForTimeout(120)
    },
    async fill(target, value, options) {
      const locator = typeof target === 'string' ? page.locator(target) : target
      await moveToLocator(locator)
      await locator.fill(value, options)
      await page.waitForTimeout(120)
    },
    async moveTo(target) {
      const locator = typeof target === 'string' ? page.locator(target) : target
      await moveToLocator(locator)
    },
  }
}

function createKeyboardOverlayHelper(page, overlayState) {
  const evaluate = async (method, command) => {
    const tokens = normalizeCommand(command)

    if (method === 'show') {
      overlayState.lastShownTokens = tokens
    }

    await page.evaluate(({ methodName, normalizedTokens }) => {
      const controller = window.__payloadE2EKeyboard

      if (methodName === 'show') {
        controller?.show(normalizedTokens)
      } else {
        controller?.[methodName](normalizedTokens[0])
      }
    }, { methodName: method, normalizedTokens: tokens })
  }

  return {
    async down(key) {
      await evaluate('down', key)
    },
    async show(command) {
      await evaluate('show', command)
    },
    async up(key) {
      await evaluate('up', key)
    },
  }
}

async function renderOverlayTokens(page, tokens) {
  await page.evaluate((normalizedTokens) => {
    const appendToDocument = (element) => {
      if (document.documentElement) {
        document.documentElement.appendChild(element)
        return
      }

      document.addEventListener('DOMContentLoaded', () => {
        document.documentElement?.appendChild(element)
      }, { once: true })
    }

    let overlay = document.getElementById('payload-e2e-keyboard')

    if (!overlay) {
      overlay = document.createElement('div')
      overlay.id = 'payload-e2e-keyboard'
      Object.assign(overlay.style, {
        alignItems: 'center',
        background: 'rgba(17, 24, 39, .9)',
        border: '1px solid rgba(255, 255, 255, .2)',
        borderRadius: '12px',
        bottom: '36px',
        boxShadow: '0 10px 28px rgba(0, 0, 0, .3)',
        color: '#fff',
        display: 'flex',
        fontFamily: 'ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
        fontSize: '18px',
        fontWeight: '600',
        gap: '8px',
        left: '50%',
        lineHeight: '1.2',
        opacity: '0',
        padding: '10px 14px',
        pointerEvents: 'none',
        position: 'fixed',
        transform: 'translateX(-50%)',
        transition: 'opacity 160ms ease',
        zIndex: '2147483647',
      })
      appendToDocument(overlay)
    }

    const elements = []

    normalizedTokens.forEach((token, index) => {
      if (index > 0) {
        const separator = document.createElement('span')
        separator.textContent = '+'
        separator.style.opacity = '.7'
        elements.push(separator)
      }

      const keycap = document.createElement('span')
      keycap.textContent = token
      Object.assign(keycap.style, {
        background: 'rgba(255, 255, 255, .14)',
        border: '1px solid rgba(255, 255, 255, .28)',
        borderRadius: '6px',
        boxShadow: 'inset 0 -1px 0 rgba(255, 255, 255, .1)',
        padding: '3px 8px',
        whiteSpace: 'nowrap',
      })
      elements.push(keycap)
    })

    overlay.replaceChildren(...elements)
    overlay.style.opacity = normalizedTokens.length > 0 ? '1' : '0'
    window.clearTimeout(window.__payloadE2EKeyboardReplayHideTimer)
    window.__payloadE2EKeyboardReplayHideTimer = window.setTimeout(() => {
      overlay.style.opacity = '0'
    }, 800)
  }, tokens)
}

function runCommand(command, args) {
  const result = childProcess.spawnSync(command, args, {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
  })

  if (result.status !== 0) {
    const stderr = result.stderr?.trim()
    const stdout = result.stdout?.trim()
    throw new Error(stderr || stdout || `${command} exited with status ${result.status}`)
  }

  return result.stdout.trim()
}

function createRecordedVideoHelper({ record, replayLastOverlay, switchRecordingTo }) {
  if (!record) {
    return null
  }

  return {
    async waitForPage(targetPage) {
      if (targetPage.url() === 'about:blank') {
        await targetPage.waitForURL((url) => url.toString() !== 'about:blank', {
          timeout: 5000,
        }).catch(() => {
          // Some popup flows never leave about:blank; fall back to the current document state.
        })
      }

      await targetPage.waitForLoadState('domcontentloaded').catch(() => {
        // Some pages may already be loaded or navigate too quickly to observe a fresh state transition.
      })
      await switchRecordingTo(targetPage)
      await replayLastOverlay(targetPage)
    },
  }
}

function installRecordedActionWrappers(page, cursor, keyboardOverlay) {
  const locatorPrototype = Object.getPrototypeOf(page.locator('body'))
  const heldKeys = new Set()
  const modifierKeys = new Set(['Alt', 'Control', 'ControlOrMeta', 'Meta', 'Shift'])
  const originalLocatorClick = locatorPrototype.click
  const originalLocatorFill = locatorPrototype.fill
  const originalLocatorPress = locatorPrototype.press
  const originalPageClick = page.click.bind(page)
  const originalPageFill = page.fill.bind(page)
  const originalPagePress = page.press.bind(page)
  const originalKeyboardDown = page.keyboard.down.bind(page.keyboard)
  const originalKeyboardPress = page.keyboard.press.bind(page.keyboard)
  const originalKeyboardUp = page.keyboard.up.bind(page.keyboard)

  const showCommand = async (command) => {
    try {
      await keyboardOverlay.show(command)
    } catch (_) {
      // The evidence overlay must never block the original product interaction.
    }
  }

  const showModifiedClick = async (options) => {
    if (options?.modifiers?.length > 0) {
      await showCommand([...options.modifiers, 'Click'])
      return
    }

    const heldModifiers = [...heldKeys].filter((key) => modifierKeys.has(key))

    if (heldModifiers.length > 0) {
      await showCommand([...heldModifiers, 'Click'])
    }
  }

  locatorPrototype.click = async function wrappedLocatorClick(...args) {
    try {
      await cursor.moveTo(this)
      await page.evaluate(() => window.__payloadE2ECursor?.pulse())
    } catch (_) {
      // Fall back to the original action if the locator re-renders mid-animation.
    }
    await showModifiedClick(args[0])
    return originalLocatorClick.apply(this, args)
  }

  locatorPrototype.fill = async function wrappedLocatorFill(...args) {
    try {
      await cursor.moveTo(this)
    } catch (_) {
      // Fall back to the original action if the locator re-renders mid-animation.
    }
    return originalLocatorFill.apply(this, args)
  }

  locatorPrototype.press = async function wrappedLocatorPress(key, options) {
    await showCommand(key)
    return originalLocatorPress.call(this, key, options)
  }

  page.click = async (selector, options) => {
    try {
      await cursor.moveTo(selector)
      await page.evaluate(() => window.__payloadE2ECursor?.pulse())
    } catch (_) {
      // Fall back to the original action if the locator re-renders mid-animation.
    }
    await showModifiedClick(options)
    return originalPageClick(selector, options)
  }

  page.fill = async (selector, value, options) => {
    try {
      await cursor.moveTo(selector)
    } catch (_) {
      // Fall back to the original action if the locator re-renders mid-animation.
    }
    return originalPageFill(selector, value, options)
  }

  page.press = async (selector, key, options) => {
    await showCommand(key)
    return originalPagePress(selector, key, options)
  }

  page.keyboard.down = async (key) => {
    heldKeys.add(key)

    try {
      await keyboardOverlay.down(key)
    } catch (_) {
      // The evidence overlay must never block the original product interaction.
    }
    return originalKeyboardDown(key)
  }

  page.keyboard.press = async (key, options) => {
    await showCommand(key)
    return originalKeyboardPress(key, options)
  }

  page.keyboard.up = async (key) => {
    const result = await originalKeyboardUp(key)
    heldKeys.delete(key)

    try {
      await keyboardOverlay.up(key)
    } catch (_) {
      // The evidence overlay must never block the original product interaction.
    }

    return result
  }
}

async function main() {
  const mod = await import(pathToFileURL(scenarioPath).href)
  const scenario = mod.default || mod.scenario || mod.run

  if (typeof scenario !== 'function') {
    throw new Error('Scenario must export a default function, scenario(), or run()')
  }

  const context = await chromium.launchPersistentContext(userDataDir, {
    headless: !headed,
    recordVideo: record ? { dir: videoDir, size: { width: 1440, height: 900 } } : undefined,
    viewport: { width: 1440, height: 900 },
  })

  const overlayState = {
    lastShownTokens: null,
  }
  const pageOrder = []
  const pageMetadata = new WeakMap()
  const recordingSegments = []
  let activeRecordedPage = null

  const registerRecordedPage = async (targetPage) => {
    if (!record) {
      return pageMetadata.get(targetPage)
    }

    let metadata = pageMetadata.get(targetPage)

    if (!metadata) {
      metadata = {
        bringToFrontWrapped: false,
        createdAtMs: Date.now(),
        index: pageOrder.length,
        isInitialized: false,
        keyboardOverlay: null,
        page: targetPage,
      }

      pageOrder.push(metadata)
      pageMetadata.set(targetPage, metadata)
    }

    if (metadata.isInitialized) {
      return metadata
    }

    await installInteractionOverlays(targetPage)

    const targetCursor = await createCursorHelper(targetPage)
    const targetKeyboardOverlay = createKeyboardOverlayHelper(targetPage, overlayState)
    metadata.keyboardOverlay = targetKeyboardOverlay
    installRecordedActionWrappers(targetPage, targetCursor, targetKeyboardOverlay)

    if (!metadata.bringToFrontWrapped) {
      const originalBringToFront = targetPage.bringToFront.bind(targetPage)
      targetPage.bringToFront = async (...args) => {
        const result = await originalBringToFront(...args)
        await switchRecordingTo(targetPage)
        return result
      }
      metadata.bringToFrontWrapped = true
    }

    metadata.isInitialized = true

    return metadata
  }

  const switchRecordingTo = async (targetPage) => {
    if (!record) {
      return
    }

    await registerRecordedPage(targetPage)

    const nowMs = Date.now()

    if (activeRecordedPage) {
      const currentSegment = recordingSegments[recordingSegments.length - 1]

      if (currentSegment && currentSegment.page === activeRecordedPage && currentSegment.endMs === null) {
        currentSegment.endMs = nowMs
      }
    }

    activeRecordedPage = targetPage
    recordingSegments.push({
      endMs: null,
      page: targetPage,
      startMs: nowMs,
    })
  }

  const replayLastOverlay = async (targetPage) => {
    if (!record || !overlayState.lastShownTokens?.length) {
      return
    }

    const metadata = pageMetadata.get(targetPage)

    if (!metadata?.keyboardOverlay) {
      return
    }

    await installInteractionOverlays(targetPage)
    await renderOverlayTokens(targetPage, overlayState.lastShownTokens)
  }

  if (record) {
    context.on('page', (targetPage) => {
      registerRecordedPage(targetPage).catch(() => {
        // Recording helpers are best-effort and must not crash the run mid-navigation.
      })
    })
  }

  const page = await context.newPage()
  const pageVideo = record ? page.video() : null
  const cursor = record ? await createCursorHelper(page) : null
  const keyboardOverlay = record ? createKeyboardOverlayHelper(page, overlayState) : null

  if (record) {
    await registerRecordedPage(page)
    await switchRecordingTo(page)
  }

  const video = createRecordedVideoHelper({
    record,
    replayLastOverlay,
    switchRecordingTo,
  })

  try {
    await scenario({
      baseURL,
      browserContext: context,
      cursor,
      expect,
      keyboardOverlay,
      label,
      page,
      record,
      repoRoot,
      video,
    })
  } finally {
    if (record && activeRecordedPage) {
      const currentSegment = recordingSegments[recordingSegments.length - 1]

      if (currentSegment && currentSegment.endMs === null) {
        currentSegment.endMs = Date.now()
      }
    }

    await context.close()
  }

  if (record) {
    const destination = `/tmp/payload-e2e-${label}.webm`

    if (!pageVideo) {
      throw new Error(`Recording was enabled but no .webm was created in ${videoDir}`)
    }

    const recordedPages = await Promise.all(pageOrder.map(async (metadata) => ({
      ...metadata,
      videoPath: await metadata.page.video()?.path(),
    })))

    const usableSegments = recordingSegments.filter((segment) => segment.endMs !== null)

    if (usableSegments.length <= 1) {
      const videoPath = await pageVideo.path()
      fs.copyFileSync(videoPath, destination)
      console.log(`Video saved to ${destination}`)
      fs.rmSync(userDataDir, { force: true, recursive: true })
      return
    }

    const stitchDir = fs.mkdtempSync(path.join(os.tmpdir(), `payload-e2e-stitch-${label}-`))
    const concatListPath = path.join(stitchDir, 'concat.txt')
    const concatEntries = []

    usableSegments.forEach((segment, index) => {
      const metadata = pageMetadata.get(segment.page)

      if (!metadata) {
        throw new Error(`Missing recording metadata for stitched segment ${index + 1}`)
      }

      const recordedPage = recordedPages.find((entry) => entry.index === metadata.index)

      if (!recordedPage?.videoPath) {
        throw new Error(`Missing video path for stitched segment ${index + 1}`)
      }

      const relativeStartSeconds = Math.max(0, (segment.startMs - metadata.createdAtMs) / 1000)
      const relativeEndSeconds = Math.max(relativeStartSeconds + 0.05, (segment.endMs - metadata.createdAtMs) / 1000)
      const segmentPath = path.join(stitchDir, `segment-${String(index + 1).padStart(2, '0')}.webm`)

      runCommand('ffmpeg', [
        '-y',
        '-ss',
        relativeStartSeconds.toFixed(3),
        '-to',
        relativeEndSeconds.toFixed(3),
        '-i',
        recordedPage.videoPath,
        '-an',
        '-c:v',
        'libvpx',
        '-b:v',
        '2M',
        segmentPath,
      ])

      concatEntries.push(`file '${segmentPath.replace(/'/g, "'\\''")}'`)
    })

    fs.writeFileSync(concatListPath, `${concatEntries.join('\n')}\n`)

    runCommand('ffmpeg', [
      '-y',
      '-f',
      'concat',
      '-safe',
      '0',
      '-i',
      concatListPath,
      '-c',
      'copy',
      destination,
    ])

    fs.rmSync(stitchDir, { force: true, recursive: true })
    console.log(`Video saved to ${destination}`)
  }

  fs.rmSync(userDataDir, { force: true, recursive: true })
}

main().catch((error) => {
  console.error(error instanceof Error ? error.message : String(error))
  process.exit(1)
})
NODE
