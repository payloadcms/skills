#!/usr/bin/env bash
# e2e-pr-assets --help | --configure KEY VALUE | --unset KEY | --show-config | --config-path
# Manages local defaults for the e2e-pr-assets helper workflow.

set -euo pipefail

resolve_script_dir() {
  local source="${BASH_SOURCE[0]}"
  while [[ -h "$source" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="${dir}/${source}"
  done
  cd -P "$(dirname "$source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"

# shellcheck source=/dev/null
source "${SCRIPT_DIR}/../lib/config.sh"

usage() {
  cat <<'EOF'
Usage:
  e2e-pr-assets --help
  e2e-pr-assets --configure KEY VALUE
  e2e-pr-assets --unset KEY
  e2e-pr-assets --show-config
  e2e-pr-assets --config-path

This command manages local defaults for the e2e-pr-assets helper scripts.
Environment variables still override config values for one-off runs.
EOF
}

config_value_for_key() {
  local lookup_key="$1"
  local config_file="$2"
  local value=""

  if [[ ! -f "$config_file" ]]; then
    return 1
  fi

  set +e
  value="$(
    CONFIG_FILE="$config_file" CONFIG_KEY="$lookup_key" bash <<'EOF'
set -euo pipefail

# shellcheck source=/dev/null
source "$CONFIG_FILE"

if [[ -z "${!CONFIG_KEY+x}" ]]; then
  exit 1
fi

printf '%s' "${!CONFIG_KEY}"
EOF
  )"
  local exit_code=$?
  set -e

  if [[ "$exit_code" -ne 0 ]]; then
    return 1
  fi

  printf '%s' "$value"
}

write_config_file() {
  local config_file="$1"
  local override_key="${2:-}"
  local override_value="${3:-}"
  local unset_key="${4:-}"
  local temp_file=""
  local key=""
  local value=""

  mkdir -p "$(dirname "$config_file")"
  temp_file="$(mktemp)"

  {
    cat <<'EOF'
# e2e-pr-assets configuration
# Environment variables override values in this file.
# Update values with `e2e-pr-assets --configure KEY VALUE`.
#
# Common keys:
# - GITHUB_BROWSER_PROFILE: path to a signed-in GitHub browser profile
# - E2E_GITHUB_AUTO_LOGIN: 1 to auto-open GitHub login when needed
# - E2E_GITHUB_AUTO_REMOVE_PROFILE: 1 to delete temporary auth profiles after upload
# - E2E_GITHUB_FORCE_REMOVE_PROFILE: 1 to allow deleting non-/tmp profiles
# - E2E_MEDIA_AUTO_CLEANUP: 1 to remove /tmp media artifacts after attach
# - E2E_VIDEO_TRIM_START_SECONDS: initial trim before MP4 conversion
# - E2E_VIDEO_AUTO_SCENE_TRIM: 1 to auto-extend trim past blank lead-in
# - E2E_VIDEO_SCENE_THRESHOLD: scene-detect sensitivity for auto-trim
# - E2E_VIDEO_SCENE_PREROLL_SECONDS: preserve a small buffer before first scene

EOF

    while IFS= read -r key; do
      value=""

      if [[ -n "$unset_key" && "$key" == "$unset_key" ]]; then
        continue
      fi

      if [[ -n "$override_key" && "$key" == "$override_key" ]]; then
        value="$override_value"
      elif value="$(config_value_for_key "$key" "$config_file")"; then
        :
      else
        continue
      fi

      printf '%s=%s\n' "$key" "$(e2e_format_config_value "$value")"
    done < <(e2e_supported_config_keys)
  } > "$temp_file"

  mv "$temp_file" "$config_file"
}

show_config() {
  local config_file="$1"

  if [[ ! -f "$config_file" ]]; then
    write_config_file "$config_file"
  fi

  cat "$config_file"
}

CONFIG_FILE="$(e2e_config_file)"

case "${1:-}" in
  --help|-h|"")
    usage
    ;;
  --config-path)
    printf '%s\n' "$CONFIG_FILE"
    ;;
  --show-config)
    show_config "$CONFIG_FILE"
    ;;
  --configure)
    if [[ $# -ne 3 ]]; then
      echo "Error: --configure requires KEY and VALUE" >&2
      usage >&2
      exit 1
    fi

    if ! e2e_is_supported_config_key "$2"; then
      echo "Error: unsupported config key: $2" >&2
      exit 1
    fi

    write_config_file "$CONFIG_FILE" "$2" "$3"
    show_config "$CONFIG_FILE"
    ;;
  --unset)
    if [[ $# -ne 2 ]]; then
      echo "Error: --unset requires KEY" >&2
      usage >&2
      exit 1
    fi

    if ! e2e_is_supported_config_key "$2"; then
      echo "Error: unsupported config key: $2" >&2
      exit 1
    fi

    write_config_file "$CONFIG_FILE" "" "" "$2"
    show_config "$CONFIG_FILE"
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 1
    ;;
esac
